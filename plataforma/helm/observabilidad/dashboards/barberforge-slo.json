      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\".*barberforge-api\",http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
