    {
      "id": 10,
      "title": "Respuestas del asistente por tipo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "llm = redactada por llama3 · aprendida = respuesta enseñada · accion = agendar/cancelar · sin_respuesta = quedó por aprender",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tipo) (increase(barberforge_chat_respuestas_total[1h]))",
          "datasource": {
