    {
      "id": 9,
      "title": "Citas creadas y canceladas (por hora)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(barberforge_citas_creadas_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "creadas"
        },
        {
          "refId": "B",
          "expr": "sum(increase(barberforge_citas_canceladas_total[1h]))",
          "datasource": {
            "type": "prometheus",
