      "title": "Errores 5xx por ruta",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
