    {
      "id": 11,
      "title": "Logs de la API (errores y advertencias)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"barberforge-api|barberforge-worker\"} |~ \"(?i)error|warning|exception\"",
