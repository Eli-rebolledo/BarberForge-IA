# Copia este archivo como .env (no se versiona) y cambia los valores.

# --- Base de datos (PostgreSQL + pgvector) ---
DB_PASSWORD=cambia-esta-clave-larga
# Alternativa: una URL completa, p. ej. para correr la API fuera de Docker:
# DATABASE_URL=postgresql://barber:barber@localhost:5432/barber

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-de-32-caracteres-o-mas
# Orígenes permitidos por CORS, separados por comas (vacío: el frontend va detrás de nginx en el mismo dominio)
CORS_ORIGINS=

# --- Administrador inicial (opcional) ---
# Si se definen, el administrador se crea al arrancar. Si no, la primera cuenta registrada queda como administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- IA local (Ollama) ---
LLM_MODEL=llama3.2:3b

# --- Correo y enlaces ---
PUBLIC_URL=http://localhost:8080
MAILHOG_URL=http://localhost:8025

# --- Barbería ---
BARBERIA_NOMBRE=BarberForge Popayán
ZONA_HORARIA=America/Bogota
SEED_DEMO=true

# --- Predicción de inasistencias (feature 011) ---
# Desde este riesgo (0 a 1) la cita recibe un aviso extra 60 min antes, además del recordatorio de 40 min.
ML_ACTIVO=true
ML_UMBRAL_RIESGO=0.20
# Citas reales cerradas (completadas / no asistió) necesarias para reentrenar con «python -m app.tareas reentrenar»
ML_MINIMO_REENTRENAMIENTO=200

# --- Asistente de voz (feature 012, perfil «voz») ---
# docker compose --profile voz up -d --build
# Whisper: tiny (más rápido) · base (equilibrio) · small (más preciso, más lento). Cambiarlo exige reconstruir.
WHISPER_MODEL=base
# Voz en español de Piper; si no se puede descargar, el navegador lee las respuestas.
PIPER_VOZ=es_MX-claude-high
TTS_ACTIVO=true
# false = la intención se detecta solo con reglas (más rápido, menos preciso; útil en equipos con poca RAM)
INTENCION_CON_LLM=true

# --- Observabilidad (opcional) ---
# Con «docker compose --profile observabilidad up -d» descomenta esta línea y abre Grafana en http://localhost:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
ENTORNO=local
