# Plantilla: la imagen de nginx reemplaza ${API_UPSTREAM}, ${VOZ_UPSTREAM} y ${DNS_RESOLVER} al arrancar.
#   Docker Compose: API_UPSTREAM=http://bf-api:8000   DNS_RESOLVER=127.0.0.11 (DNS interno de Docker)
#   Kubernetes:     API_UPSTREAM=http://<release>-api:8000   DNS_RESOLVER=kube-dns.kube-system.svc.cluster.local
server {
  listen 8080;
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  server_tokens off;

  gzip on;
  gzip_types text/css application/javascript application/json text/plain;

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_read_timeout 180s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  # Feature 012: asistente de voz (contenedor bf-voz). Si no está levantado, nginx responde 502 y la web lo avisa.
  location /voz/ {
    set $voz_upstream ${VOZ_UPSTREAM};
    proxy_pass $voz_upstream;
    client_max_body_size 4m;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  root /usr/share/nginx/html;

  # Archivos de Next.js con hash en el nombre: se pueden cachear para siempre.
  location /_next/static/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Páginas exportadas por Next.js: /citas -> citas.html, /admin/barberos -> admin/barberos.html
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri.html $uri/ =404;
  }

  error_page 404 /404.html;
}
