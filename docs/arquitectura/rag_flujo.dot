digraph G {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.42, fontname="DejaVu Sans", bgcolor="white", dpi=200];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, color="#1E64B4", fillcolor="#E8F0FA", penwidth=1.6, margin="0.18,0.08"];
  edge  [color="#555555", fontname="DejaVu Sans", fontsize=11, penwidth=1.3, arrowsize=0.8];
  msg   [label="Mensaje del usuario (máx. 500 caracteres)", color="#888888", fillcolor="#F3F3F3"];
  guard [label="Guardas: inyección de instrucciones y\ndatos de otras personas (expresiones regulares)"];
  reglas[label="Reglas de intención: saludo, cancelar, mis citas,\nagenda de hoy, PQRS (pide el detalle), agendar"];
  accion[label="Acción directa sobre la base de datos\n(citas, PQRS) — sin LLM", color="#2E7D32", fillcolor="#E8F3E8"];
  emb   [label="1. Embedding de la pregunta\nnomic-embed-text → vector de 768"];
  ense  [label="2. ¿Pregunta ya enseñada?\nigualdad, parecido ≥ 0,6 o distancia coseno ≤ 0,08"];
  busq  [label="3. Recuperación: búsqueda en pgvector\n3 fragmentos más cercanos, filtrados por el rol"];
  aum   [label="4. Aumentación del prompt\ninstrucciones + CONTEXTO (fragmentos) + PREGUNTA", color="#6A4C93", fillcolor="#EFE9F6"];
  llm   [label="5. Generación: llama3.2:3b redacta solo con el CONTEXTO\n(temperatura 0,2 · 200 tokens · contexto 2.048)"];
  resp  [label="Respuesta con fuentes · 👍/👎", color="#2E7D32", fillcolor="#E8F3E8"];
  nose  [label="«Todavía no sé responder eso» →\nbandeja «Por aprender»", color="#C0172C", fillcolor="#FBE9E9"];
  resp2 [label="Respaldo sin LLM: respuesta enseñada o fragmento\ncon cobertura de palabras ≥ 60 %", color="#E07A00", fillcolor="#FDF1E2"];
  msg -> guard -> reglas;
  reglas -> accion [label=" intención de acción"];
  reglas -> emb [label=" pregunta"];
  emb -> ense;
  ense -> busq [label=" no"];
  ense -> aum [label=" sí: respuesta oficial\n como contexto", style=dashed];
  busq -> aum [label=" hay contexto"];
  busq -> nose [label=" sin fragmentos"];
  aum -> llm;
  llm -> resp;
  llm -> nose [label=" dice que no sabe"];
  llm -> resp2 [label=" Ollama falla"];
  resp2 -> resp;
  resp2 -> nose [label=" cobertura < 60 %"];
  {rank=same; accion; emb}
}
